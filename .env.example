# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here

# Demo account passwords (set your own values in .env.local or Render; never commit them).
DEMO_CITIZEN_PASSWORD=change_me
DEMO_ROADS_PASSWORD=change_me
DEMO_SANITATION_PASSWORD=change_me
DEMO_ELECTRICITY_PASSWORD=change_me
DEMO_WATER_PASSWORD=change_me
DEMO_NIGAM_PASSWORD=change_me
DEMO_ADMIN_PASSWORD=change_me

# MONGO_URI: Optional MongoDB Atlas / local MongoDB connection string.
# Set this to enable persistent data storage for users and complaints.
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/nagarvani
MONGO_URI=mongodb://localhost:27017/nagarvani

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
